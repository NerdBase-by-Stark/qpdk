-- Simple Button Plugin
-- A minimal Q-SYS plugin demonstrating correct structure

PluginInfo = {
    Name = "Examples~Simple Button",
    Version = "1.0.0",
    BuildVersion = "1.0.0.0",
    Id = "com.qpdk.examples.simple-button",
    Author = "QPDK",
    Description = "A simple button that toggles state",
    ShowDebug = true
}

function GetProperties()
    local props = {}
    table.insert(props, {
        Name = "Initial State",
        Type = "boolean",
        Value = false
    })
    return props
end

function GetControls(props)
    local ctls = {}
    table.insert(ctls, {
        Name = "Toggle",
        ControlType = "Button",
        ButtonType = "Toggle",
        Count = 1,
        UserPin = true,
        PinStyle = "Both"
    })
    table.insert(ctls, {
        Name = "State",
        ControlType = "Indicator",
        IndicatorType = "Led",
        Count = 1,
        UserPin = true,
        PinStyle = "Output"
    })
    table.insert(ctls, {
        Name = "Status",
        ControlType = "Indicator",
        IndicatorType = "Status",
        Count = 1,
        UserPin = true,
        PinStyle = "Output"
    })
    return ctls
end

function GetControlLayout(props)
    local layout = {}
    local graphics = {}

    layout["Toggle"] = {
        PrettyName = "Toggle Button",
        Style = "Button",
        ButtonStyle = "Toggle",
        Position = {10, 10},
        Size = {100, 32}
    }

    layout["State"] = {
        PrettyName = "State LED",
        Style = "Led",
        Position = {120, 10},
        Size = {32, 32}
    }

    layout["Status"] = {
        PrettyName = "Status",
        Style = "Text",
        Position = {10, 52},
        Size = {142, 32}
    }

    return layout, graphics
end

-- Runtime code
if Controls then
    -- Module-level timer (correct scoping)
    local StateTimer = Timer.New()

    -- Initialize
    local function Initialize()
        -- Guard the property read so a missing property cannot crash the callback.
        local initial = Properties["Initial State"]
        Controls["State"].Boolean = initial ~= nil and initial.Value == true
        Controls["Status"].Value = 0      -- 0 = OK
        Controls["Status"].String = "OK"
    end

    -- Toggle handler
    Controls["Toggle"].EventHandler = function(ctrl)
        local newState = ctrl.Boolean
        Controls["State"].Boolean = newState
        Log.Message("Toggle changed to: " .. tostring(newState))
    end

    -- Initialize on load
    Timer.CallAfter(Initialize, 0.1)
end
