-- Fixture: status_out_of_range.qplug
-- Tests QPDK023: status control set to value outside valid range (0-5).
-- Q-SYS StatusState constants: OK=0, Compromised=1, Fault=2,
-- NotPresent=3, Missing=4, Initializing=5
-- Value 7 is undefined and produces unpredictable UI behavior.

PluginInfo = { Name = "Test~Status Out of Range", Version = "1.0.0", Id = "test.status-range" }

function GetProperties() return {} end

function GetControls()
  return {
    { Name = "status", ControlType = "Indicator", IndicatorType = "Status", Count = 1 }
  }
end

function GetControlLayout() return {}, {} end

if Controls then
  Controls.Outputs["status"].Value = 7
end
