-- Comprehensive .luacheckrc for Q-SYS Plugin Development
-- Use with: luacheck --config .luacheckrc-qsys plugin.qplug

std = "lua53"

-- Q-SYS global APIs
globals = {
    -- Core Runtime
    "Controls",
    "Properties",
    "System",
    "Design",
    "Status",
    "StatusState",
    "Log",

    -- Timers
    "Timer",

    -- Network
    "TcpSocket",
    "UdpSocket",
    "HttpClient",
    "Ssh",

    -- Components
    "Component",
    "NamedControl",

    -- UI
    "Uci",
    "Snapshot",

    -- Serial/IO
    "SerialPorts",
    "Gpio",

    -- Audio
    "Mixer",
    "Audio",

    -- Plugin structure functions
    "PluginInfo",
    "GetProperties",
    "GetControls",
    "GetControlLayout",
    "GetPages",
    "GetPins",
    "GetComponents",
    "GetWiring",
    "GetPrettyName",
    "GetColor",
    "RectifyProperties",
    "HandleDebug",

    -- Q-SYS v9+ additions
    "Notifications",
    "IsManaged",
}

-- Read-only globals (can't be reassigned)
read_globals = {
    "StatusState",
    "System",
    "Design",
}

-- Patterns to ignore
ignore = {
    "211",  -- Unused local variable (common in Q-SYS callbacks)
    "212",  -- Unused argument (common in event handlers)
    "213",  -- Unused loop variable
    "542",  -- Empty if branch
    "611",  -- Line is too long (handled by max_line_length)
}

-- Max line length (Q-SYS Designer has wide code windows)
max_line_length = 150

-- Max cyclomatic complexity
max_cyclomatic_complexity = 25

-- Files to exclude
exclude_files = {
    "tests/*",
    "*.backup",
    "*.bak",
}

-- Custom stds for different Q-SYS versions
stds.qsys7 = {
    globals = {
        "Controls", "Properties", "System", "Design", "Status", "StatusState", "Log",
        "Timer", "TcpSocket", "UdpSocket", "HttpClient", "Ssh",
        "Component", "NamedControl", "Uci", "Snapshot",
        "SerialPorts", "Gpio", "Mixer",
        "PluginInfo", "GetProperties", "GetControls", "GetControlLayout",
        "GetPages", "GetPins", "GetComponents", "GetWiring",
        "GetPrettyName", "GetColor", "RectifyProperties", "HandleDebug",
    }
}

stds.qsys9 = {
    globals = {
        "Controls", "Properties", "System", "Design", "Status", "StatusState", "Log",
        "Timer", "TcpSocket", "UdpSocket", "HttpClient", "Ssh",
        "Component", "NamedControl", "Uci", "Snapshot",
        "SerialPorts", "Gpio", "Mixer", "Audio",
        "PluginInfo", "GetProperties", "GetControls", "GetControlLayout",
        "GetPages", "GetPins", "GetComponents", "GetWiring",
        "GetPrettyName", "GetColor", "RectifyProperties", "HandleDebug",
        "Notifications", "IsManaged",
    }
}
